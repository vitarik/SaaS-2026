<div class="row mt-4">
  <div class="col-md-12">
    <div class="card text-white bg-info mb-3">
      <div class="card-header">
        Budget Overview - <%= new Date(currentYear, currentMonth - 1).toLocaleString('default', { month: 'long', year: 'numeric' }) %>
      </div>
      <div class="card-body">
        <table class="table table-sm text-white">
          <thead>
            <tr>
              <th></th>
              <th>IN</th>
              <th>OUT</th>
              <th>REST</th>
            </tr>
          </thead>
          <tbody>
            <tr style="background-color: blue;">
              <td>Estimation</td>
              <td>$<%= monthlyIncomeEstimate.toFixed(2) %></td>
              <td>$<%= totalPredicted.toFixed(2) %></td>
              <td>$<%= (monthlyIncomeEstimate - totalPredicted).toFixed(2) %></td>
            </tr>
            <tr style="background-color: black;">
              <td>Current</td>
              <td>$<%= currentIncome.toFixed(2) %></td>
              <td>$<%= totalReal.toFixed(2) %></td>
              <td>$<%= (currentIncome - totalReal).toFixed(2) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="row mt-4">
  <div class="col-md-12">
    <form method="get" action="/">
      <div class="form-group">
        <label for="month">Month:</label>
        <select class="form-control" id="month" name="month">
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= m == currentMonth ? 'selected' : '' %>>
              <%= new Date(0, m - 1).toLocaleString('default', { month: 'long' }) %>
            </option>
          <% } %>
        </select>
      </div>
      
      <div class="form-group">
        <label for="year">Year:</label>
        <select class="form-control" id="year" name="year">
          <% for (let y = new Date().getFullYear() - 5; y <= new Date().getFullYear() + 5; y++) { %>
            <option value="<%= y %>" <%= y == currentYear ? 'selected' : '' %>>
              <%= y %>
            </option>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label for="category">Category:</label>
        <select class="form-control" id="category" name="category">
          <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All</option>
          <option value="house" <%= selectedCategory === 'house' ? 'selected' : '' %>>House</option>
          <option value="daily_life" <%= selectedCategory === 'daily_life' ? 'selected' : '' %>>Daily Life</option>
          <option value="transport" <%= selectedCategory === 'transport' ? 'selected' : '' %>>Transport</option>
          <option value="savings-debts" <%= selectedCategory === 'savings-debts' ? 'selected' : '' %>>Savings/Debts</option>
        </select>
      </div>
      
      <button type="submit" class="btn btn-primary">Select</button>
    </form>
  </div>
</div>
